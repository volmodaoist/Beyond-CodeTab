{
  "name": "obsidian-code-tab",
  "version": "2.2.1",
  "description": "Render polished Markdown tab groups with inline content editing.",
  "main": "dist/main.js",
  "license": "MIT",
  "scripts": {
    "build": "npm run typecheck && node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:obsidian": "npm run build && node tests/obsidian/inline-edit.mjs && node tests/obsidian/tab-controls.mjs && node tests/obsidian/markdown-content.mjs",
    "lint": "eslint . && prettier --check src \"tests/**/*.mjs\" \"*.mjs\" package.json tsconfig.json .prettierrc.json",
    "lint:fix": "eslint . --fix && prettier --write src \"tests/**/*.mjs\" \"*.mjs\" package.json tsconfig.json .prettierrc.json",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "^9.39.5",
    "@types/prismjs": "1.26.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "obsidian": "1.13.1",
    "playwright": "1.58.2",
    "prettier": "^3.9.9",
    "prismjs": "1.30.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.46.4"
  },
  "engines": {
    "node": ">=20"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint"
  }
}
