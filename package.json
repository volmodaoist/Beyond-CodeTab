{
    "name": "obsidian-code-tab",
    "version": "2.2.1",
    "description": "Render polished Markdown tab groups with inline content editing.",
    "main": "dist/main.js",
    "license": "MIT",
    "scripts": {
        "build": "npm run typecheck && node esbuild.config.mjs",
        "dev": "node esbuild.config.mjs --watch",
        "typecheck": "tsc --noEmit",
        "test": "node --test tests/*.test.mjs",
        "test:obsidian": "npm run build && node tests/obsidian/inline-edit.mjs"
    },
    "devDependencies": {
        "@codemirror/state": "6.5.0",
        "@codemirror/view": "6.38.6",
        "@types/prismjs": "1.26.6",
        "esbuild": "^0.28.2",
        "obsidian": "1.13.1",
        "playwright": "1.58.2",
        "prismjs": "1.30.0",
        "typescript": "^5.9.2"
    },
    "engines": {
        "node": ">=20"
    }
}
